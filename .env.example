# Django
# single quotes: compose interpolates $VAR in unquoted values (Django keys may contain $)
# Optional locally: without it a random key is generated at every start.
DJANGO_SECRET_KEY='change-me'
DJANGO_DEBUG=True
# In production add the public hostname (e.g. coperni.example.org) and its https origin
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# CAMS / Copernicus Atmosphere Data Store (needed only by the cams_export job)
CDS_API_URL=https://ads.atmosphere.copernicus.eu/api
CDS_API_KEY=

# Where the daily Parquet files live: gs://<bucket>/cams in production (public-read bucket,
# read by the web over HTTPS), a local folder in development (default: data/cams)
CAMS_STORAGE=

# Initial map background (OpenFreeMap, no key needed): dark (default) or light; users can switch
# it on the map.
MAP_BASEMAP=dark

# Optional cookieless analytics: token of the Cloudflare Web Analytics JS snippet (empty = off)
CLOUDFLARE_ANALYTICS_TOKEN=

# Map centre when the URL does not specify one (?comune=, ?citta=, ?lat=&lon=).
# Default: Mezzolombardo (TN)
COPERNICUS_LATITUDE=46.215022
COPERNICUS_LONGITUDE=11.092251
COPERNICUS_POLLUTANTS=pm2p5,pm10,no2,o3,so2
COPERNICUS_RETENTION_DAYS=21

# Air quality thresholds (µg/m³). Defaults = EU values (PM2.5/PM10: daily limits from 2030).
COPERNICUS_SOGLIA_PM2P5=25.0
COPERNICUS_SOGLIA_PM10=45.0
COPERNICUS_SOGLIA_NO2=200.0
COPERNICUS_SOGLIA_O3=180.0
COPERNICUS_SOGLIA_SO2=350.0
